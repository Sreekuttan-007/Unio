# Copy to .env for local work. Never commit .env.
APP_ENV=dev
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=unio

# Required outside dev, at least 32 bytes. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# One-tap demo sign-in and seeded demo accounts. Turn OFF for anything real.
DEMO_MODE_ENABLED=true
DEMO_USER_PASSWORD=

# Gemini (used from Phase 4)
GEMINI_API_KEY=
